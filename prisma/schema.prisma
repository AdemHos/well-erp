// Shared business contact; balances are derived from branch-scoped entries.
model CurrentAccount {
 supplier Supplier?
 customer Customer?
 payments Payment[]
 invoices Invoice[]
  expenses Expense[]
  id String @id @default(cuid())
  organizationId String
  code String
  name String
  type CurrentAccountType
  phone String?
  email String?
  address String?
  taxOffice String?
  taxNumber String?
  description String?
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  entries CurrentAccountEntry[]
  @@unique([id, organizationId])
  @@unique([organizationId, code])
  @@index([organizationId, isActive, type])
}

model CurrentAccountEntry {
 paymentReversals Payment[] @relation("PaymentCurrentReversal")
 invoiceAccrual Invoice? @relation("InvoiceAccrual")
 invoiceReversal Invoice? @relation("InvoiceReversal")
  expenseId String?
  expense Expense? @relation(fields: [expenseId, organizationId, branchId], references: [id, organizationId, branchId], onDelete: Restrict)
  expensePayments Payment[]
  @@unique([id, organizationId, branchId])
  @@index([expenseId])
  id String @id @default(cuid())
  organizationId String
  currentAccountId String
  branchId String
  direction CurrentAccountDirection
  kind CurrentAccountEntryKind
  amount Decimal @db.Decimal(14, 2)
  description String?
  reference String?
  occurredAt DateTime @default(now())
  createdAt DateTime @default(now())
  createdByUserId String
  createdByProfileId String?
  idempotencyKey String
  requestHash String
  reversalOfId String? @unique
  financeTransactionId String? @unique
  sourceKey String?
  dueAt DateTime?
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  currentAccount CurrentAccount @relation(fields: [currentAccountId, organizationId], references: [id, organizationId], onDelete: Restrict)
  branch Branch @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  createdBy User @relation("CurrentEntryCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdByProfile StaffProfile? @relation("CurrentEntryProfile", fields: [createdByProfileId, organizationId], references: [id, organizationId], onDelete: Restrict)
  reversalOf CurrentAccountEntry? @relation("CurrentEntryReversal", fields: [reversalOfId, organizationId, currentAccountId, branchId], references: [id, organizationId, currentAccountId, branchId], onDelete: Restrict, onUpdate: NoAction)
  reversals CurrentAccountEntry[] @relation("CurrentEntryReversal")
  financeTransaction FinanceTransaction? @relation(fields: [financeTransactionId, organizationId, branchId], references: [id, organizationId, branchId], onDelete: Restrict)
  @@unique([id, organizationId, currentAccountId, branchId])
  @@unique([organizationId, idempotencyKey])
  @@unique([organizationId, sourceKey])
  @@index([organizationId, currentAccountId, occurredAt, createdAt, id])
  @@index([organizationId, branchId, occurredAt])
}

enum CurrentAccountType {
  CUSTOMER
  SUPPLIER
  BOTH
}
enum CurrentAccountDirection {
  DEBIT
  CREDIT
}
enum CurrentAccountEntryKind {
  EXPENSE
  OPENING
  ADJUSTMENT
  REVERSAL
  CREDIT_SALE
  CREDIT_PURCHASE
  INVOICE
  COLLECTION
  PAYMENT
}

model Expense {
