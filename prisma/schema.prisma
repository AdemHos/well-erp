
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ======================================================
// USER & AUTH
// ======================================================

model User {
  acknowledgedRequests ServiceRequest[] @relation("RequestAcknowledgedUser")
  completedRequests ServiceRequest[] @relation("RequestCompletedUser")
  cancelledRequests ServiceRequest[] @relation("RequestCancelledUser")
 createdSuppliers Supplier[] @relation("SupplierCreator")
 createdCustomers Customer[] @relation("CustomerCreator")
 cancelledPayments Payment[] @relation("PaymentCanceller")
 createdInvoices Invoice[] @relation("InvoiceCreator")
 invoiceAllocations InvoicePaymentAllocation[]
  createdExpenses Expense[] @relation("ExpenseCreator")
  cancelledExpenses Expense[] @relation("ExpenseCanceller")
  expensePayments Payment[] @relation("ExpensePaymentCreator")
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?

  profileSessions StaffProfileSession[]
  accounts    Account[]
  memberships Membership[]
  staffInvitations StaffInvitation[] @relation("InvitationCreator")
  currentAccountEntries CurrentAccountEntry[] @relation("CurrentEntryCreator")
  auditEvents AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String

  refresh_token String?
  access_token  String?
  expires_at    Int?
  token_type    String?
  scope         String?
  id_token      String?
  session_state String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// ======================================================
// ORGANIZATION / MULTI-TENANT
// ======================================================

model Organization {
  printerSettings BranchPrinterSetting[]
  qrMenus BranchQrMenu[]
  serviceRequests ServiceRequest[]
 suppliers Supplier[]
 supplierProducts SupplierProduct[]
 customers Customer[]
 invoices Invoice[]
 invoiceItems InvoiceItem[]
 invoiceAllocations InvoicePaymentAllocation[]
  expenses Expense[]
  expensePayments Payment[]
  id   String @id @default(cuid())
  name String
  slug String @unique
  legalName String? @db.VarChar(160)
  businessType String? @db.VarChar(60)
  phone String? @db.VarChar(30)
  email String? @db.VarChar(254)
  website String? @db.VarChar(500)
  address String? @db.VarChar(500)
  city String? @db.VarChar(80)
  district String? @db.VarChar(80)
  taxOffice String? @db.VarChar(120)
  taxNumber String? @db.VarChar(11)
  logoUrl String? @db.VarChar(500)
  branchSettings BranchSettings[]

  staffProfiles StaffProfile[]
  invitations StaffInvitation[]
  auditLogs AuditLog[]
  memberships         Membership[]
  branches            Branch[]
  categories          Category[]
  products            Product[]
  branchStocks        BranchStock[]
  stockMovements      StockMovement[]
  recipes             Recipe[]
  productions         Production[]
  orders              Order[]
  restaurantTables    RestaurantTable[]
  tabs                Tab[]
  currentAccounts CurrentAccount[]
  currentAccountEntries CurrentAccountEntry[]
  financeAccounts     FinanceAccount[]
  financeCategories   FinanceCategory[]
  financeTransactions FinanceTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Membership {
  id             String @id @default(cuid())
  userId         String
  organizationId String
  role           Role   @default(STAFF)
  isActive Boolean @default(true)
  allBranches Boolean @default(true)
  staffProfile StaffProfile?
  branchAccess MembershipBranch[]

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, organizationId])
  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([userId])
}

model Branch {
  settings BranchSettings?
  printerSetting BranchPrinterSetting?
  qrMenu BranchQrMenu?
  serviceRequests ServiceRequest[]
 invoices Invoice[]
 invoiceItems InvoiceItem[]
 invoiceAllocations InvoicePaymentAllocation[]
  expenses Expense[]
  expensePayments Payment[]
  profileAccess StaffProfileBranch[]
  memberAccess MembershipBranch[]
  invitationAccess InvitationBranch[]
  auditLogs AuditLog[]
  id             String @id @default(cuid())
  name           String
  organizationId String

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stocks              BranchStock[]
  stockMovements      StockMovement[]
  productions         Production[]
  orders              Order[]
  restaurantTables    RestaurantTable[]
  tabs                Tab[]
  currentAccountEntries CurrentAccountEntry[]
  financeAccounts     FinanceAccount[]
  financeTransactions FinanceTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@unique([id, organizationId])
}

// ======================================================
// CATEGORY
// ======================================================

model BranchPrinterSetting {
  id String @id @default(cuid())
  organizationId String
  branchId String @unique
  paperWidth String @default("80")
  receiptHeader String @default("") @db.VarChar(160)
  receiptFooter String @default("Teşekkür ederiz. Yine bekleriz!") @db.VarChar(300)
  afterSalePrint String @default("MANUAL")
  showOrganization Boolean @default(true)
  showBranch Boolean @default(true)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch Branch @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([branchId, organizationId])
  @@index([organizationId])
}

model BranchSettings {
  id String @id @default(cuid())
  organizationId String
  branchId String @unique
  defaultPaymentMethod String @default("CASH")
  discountRoles String[] @default(["OWNER", "ADMIN", "MANAGER", "CASHIER"])
  maxDiscountPercent Int @default(100)
  refundRoles String[] @default(["OWNER", "ADMIN", "MANAGER"])
  refundReasonRequired Boolean @default(false)
  customerSelection String @default("OPTIONAL")
  allowNegativeStock Boolean @default(false)
  criticalStockEnabled Boolean @default(true)
  defaultCriticalLevel Decimal @default(0) @db.Decimal(14, 3)
  notificationsEnabled Boolean @default(true)
  waiterNotification Boolean @default(true)
  billNotification Boolean @default(true)
  criticalStockNotification Boolean @default(true)
  notificationSound Boolean @default(true)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch Branch @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([branchId, organizationId])
  @@index([organizationId])
}

model Category {
  id             String @id @default(cuid())
  name           String
  organizationId String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products     Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
  @@unique([id, organizationId])
}

// ======================================================
// PRODUCT
// ======================================================

model Product {
 suppliers SupplierProduct[]
 invoiceItems InvoiceItem[]
 @@unique([id, organizationId])
  id          String      @id @default(cuid())
  name        String
  description String?
  sku         String?
  barcode     String?
  imageUrl    String?
  price       Decimal     @db.Decimal(12, 2)
  costPrice   Decimal?    @db.Decimal(12, 2)
  unit        ProductUnit @default(PIECE)
  isActive    Boolean     @default(true)
  isSellable  Boolean     @default(true)

  organizationId String
  categoryId     String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     Category?    @relation(fields: [categoryId, organizationId], references: [id, organizationId], onDelete: Restrict)

  branchStocks   BranchStock[]
  stockMovements StockMovement[]
  orderItems     OrderItem[]
  tabItems       TabItem[]

  // Recipe relations
  recipe      Recipe?      @relation("ProductRecipe")
  recipeItems RecipeItem[] @relation("RecipeIngredient")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, sku])
  @@unique([organizationId, barcode])
  @@index([organizationId])
  @@index([categoryId])
}

// ======================================================
// STOCK
// ======================================================

model BranchStock {
  id            String  @id @default(cuid())
  quantity      Decimal @default(0) @db.Decimal(14, 3)
  criticalLevel Decimal @default(0) @db.Decimal(14, 3)

  organizationId String
  branchId       String
  productId      String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  product      Product      @relation(fields: [productId, organizationId], references: [id, organizationId], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, productId])
  @@index([organizationId])
  @@index([branchId])
  @@index([productId])
}

model StockMovement {
  id       String            @id @default(cuid())
  type     StockMovementType
  quantity Decimal           @db.Decimal(14, 3)

  note      String?
  reference String?

  organizationId String
  branchId       String
  productId      String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  product      Product      @relation(fields: [productId, organizationId], references: [id, organizationId], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([branchId])
  @@index([productId])
  @@index([createdAt])
  @@index([branchId, productId])
}

// ======================================================
// RECIPES
// ======================================================

model Recipe {
  id             String  @id @default(cuid())
  organizationId String
  productId      String
  name           String?
  yieldQuantity  Decimal @default(1) @db.Decimal(14, 3)
  isActive       Boolean @default(true)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product      @relation("ProductRecipe", fields: [productId, organizationId], references: [id, organizationId], onDelete: Restrict)
  items        RecipeItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId])
  @@unique([productId, organizationId])
  @@index([organizationId])
}

model RecipeItem {
  id           String  @id @default(cuid())
  recipeId     String
  ingredientId String
  quantity     Decimal @db.Decimal(14, 3)

  recipe     Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient Product @relation("RecipeIngredient", fields: [ingredientId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([recipeId, ingredientId])
  @@index([ingredientId])
}

// ======================================================
// PRODUCTION MANAGEMENT
// ======================================================

model Production {
  id String @id @default(cuid())

  // Tenant and branch
  organizationId String
  branchId       String

  // Product and recipe snapshot references
  productId   String
  productName String

  recipeId   String
  recipeName String?

  // Quantity of finished product
  quantity Decimal @db.Decimal(14, 3)

  // Cost snapshot at production time
  totalCost Decimal @db.Decimal(14, 2)
  unitCost  Decimal @db.Decimal(14, 4)

  note String?

  // Relationships
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)

  items ProductionItem[]

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([branchId, createdAt])
  @@index([productId])
  @@index([recipeId])
}

model ProductionItem {
  id String @id @default(cuid())

  productionId String

  // Ingredient snapshot reference
  ingredientId   String
  ingredientName String
  ingredientUnit ProductUnit

  // Quantity consumed
  quantity Decimal @db.Decimal(14, 3)

  // Cost snapshot
  unitCost  Decimal @db.Decimal(14, 4)
  totalCost Decimal @db.Decimal(14, 2)

  production Production @relation(fields: [productionId], references: [id], onDelete: Cascade)

  @@index([productionId])
  @@index([ingredientId])
}

// ======================================================
// POS / ORDERS
// ======================================================

model Order {
 businessSnapshot Json?
 customerId String?
 customerSnapshot Json?
 customer Customer? @relation(fields: [customerId, organizationId], references: [id, organizationId], onDelete: Restrict)
 @@index([organizationId, customerId, createdAt])
 @@index([organizationId, customerId, branchId, createdAt])
 invoice Invoice?
 @@unique([id, organizationId, branchId])
  id String @id @default(cuid())

  orderNumber String

  status        OrderStatus   @default(COMPLETED)
  paymentMethod PaymentMethod

  subtotal Decimal @db.Decimal(12, 2)

  // POS discount information
  discountType   DiscountType?
  discountValue  Decimal @default(0) @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)

  total Decimal @db.Decimal(12, 2)

  note String?

  organizationId String
  branchId       String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)

  items               OrderItem[]
  tab                 Tab?
  financeTransactions FinanceTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, orderNumber])
  @@index([organizationId])
  @@index([branchId])
  @@index([status])
  @@index([createdAt])
  @@index([organizationId, createdAt])
  @@index([organizationId, branchId, createdAt])
}

model OrderItem {
  id String @id @default(cuid())

  quantity  Decimal @db.Decimal(12, 3)
  unitPrice Decimal @db.Decimal(12, 2)
  total     Decimal @db.Decimal(12, 2)

  // Keep product name from time of sale
  productName String

  orderId   String
  productId String?

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

// ======================================================
// RESTAURANT / TABLES
// ======================================================

model RestaurantTable {
  qrTokenHash String? @unique
  qrTokenRotatedAt DateTime?
  requestWindowStartedAt DateTime?
  requestWindowCount Int @default(0)
  serviceRequests ServiceRequest[]
  @@unique([id, branchId, organizationId])
  id       String  @id @default(cuid())
  name     String
  capacity Int     @default(4)
  isActive Boolean @default(true)

  organizationId String
  branchId       String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)

  tabs Tab[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, name])
  @@index([organizationId])
  @@index([branchId])
}

// ======================================================
// RESTAURANT / TABS
// ======================================================

model Tab {
  serviceRequests ServiceRequest[]
  @@unique([id, tableId, branchId, organizationId])
  id        String    @id @default(cuid())
  tabNumber String
  status    TabStatus @default(OPEN)

  note String?

  subtotal Decimal @default(0) @db.Decimal(12, 2)
  total    Decimal @default(0) @db.Decimal(12, 2)

  organizationId String
  branchId       String
  tableId        String

  orderId String? @unique

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch          @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  table        RestaurantTable @relation(fields: [tableId, branchId, organizationId], references: [id, branchId, organizationId], onDelete: Restrict)
  order        Order?          @relation(fields: [orderId, organizationId, branchId], references: [id, organizationId, branchId], onDelete: Restrict)

  items TabItem[]

  openedAt DateTime  @default(now())
  closedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, tabNumber])
  @@unique([orderId, organizationId, branchId])
  @@index([organizationId, status])
  @@index([branchId, status])
  @@index([tableId, status])
}

model TabItem {
  id String @id @default(cuid())

  quantity  Decimal @db.Decimal(12, 3)
  unitPrice Decimal @db.Decimal(12, 2)
  total     Decimal @db.Decimal(12, 2)

  productName String

  note String?

  kitchenStatus KitchenStatus @default(PENDING)

  kitchenStartedAt DateTime?
  kitchenReadyAt   DateTime?
  kitchenServedAt  DateTime?

  tabId     String
  productId String?

  tab     Tab      @relation(fields: [tabId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tabId])
  @@index([productId])
  @@index([kitchenStatus])
}

// ======================================================
// FINANCE / ACCOUNTS, CATEGORIES, TRANSACTIONS
// ======================================================

// Each branch can have separate cash, card, and bank accounts.
// Current balance = openingBalance + IN transactions - OUT transactions.
model FinanceAccount {
  id             String             @id @default(cuid())
  organizationId String
  branchId       String
  name           String
  type           FinanceAccountType
  openingBalance Decimal            @default(0) @db.Decimal(14, 2)
  isActive       Boolean            @default(true)

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch               @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  transactions FinanceTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, name])
  @@index([organizationId, branchId])
  @@index([branchId, type])
  @@unique([id, organizationId, branchId])
}

// Shared organization-level income/expense categories.
model FinanceCategory {
  expenses Expense[]
  @@unique([id, organizationId])
  id             String           @id @default(cuid())
  organizationId String
  name           String
  direction      FinanceDirection
  isActive       Boolean          @default(true)

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactions FinanceTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, name, direction])
  @@index([organizationId, direction])
}

// Positive amount; direction determines cash flow.
// POS orders are linked for traceability and duplicate prevention.
model FinanceTransaction {
 paymentReversals Payment[] @relation("PaymentFinanceReversal")
  expensePayments Payment[]
  currentAccountEntries CurrentAccountEntry[]
  id             String  @id @default(cuid())
  organizationId String
  branchId       String
  accountId      String
  categoryId     String?
  orderId        String?

  direction   FinanceDirection
  source      FinanceSource    @default(MANUAL)
  amount      Decimal          @db.Decimal(14, 2)
  description String?
  reference   String?
  occurredAt  DateTime         @default(now())

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch           @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  account      FinanceAccount   @relation(fields: [accountId, organizationId, branchId], references: [id, organizationId, branchId], onDelete: Restrict)
  category     FinanceCategory? @relation(fields: [categoryId, organizationId], references: [id, organizationId], onDelete: Restrict)
  order        Order?           @relation(fields: [orderId, organizationId, branchId], references: [id, organizationId, branchId], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // A single POS sale (or refund) cannot be booked twice.
  @@unique([id, organizationId, branchId])
  @@unique([orderId, source])
  @@index([organizationId, occurredAt])
  @@index([branchId, occurredAt])
  @@index([accountId, occurredAt])
  @@index([categoryId])
  @@index([source])
}

// ======================================================
// ENUMS
// ======================================================

enum Role {
  OWNER
  ADMIN
  MANAGER
  CASHIER
  WAITER
  KITCHEN
  STAFF
}

enum ProductUnit {
  PIECE
  GRAM
  KILOGRAM
  MILLILITER
  LITER
}

enum StockMovementType {
  PURCHASE
  SALE
  RETURN
  WASTE
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  TRANSFER_IN
  TRANSFER_OUT

  // Production stock movements
  PRODUCTION_IN
  PRODUCTION_OUT
}

enum OrderStatus {
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
}

enum DiscountType {
  PERCENT
  FIXED
}

enum TabStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum KitchenStatus {
  PENDING
  PREPARING
  READY
  SERVED
}

// ======================================================
// FINANCE ENUMS
// ======================================================

enum FinanceAccountType {
  CASH
  CARD
  BANK
}

enum FinanceDirection {
  IN
  OUT
}

enum FinanceSource {
 PAYMENT
 PAYMENT_REVERSAL
  EXPENSE_PAYMENT
  MANUAL
  POS_SALE
  POS_REFUND
}

// RBAC: existing memberships keep their current all-branch scope.
model MembershipBranch {
  membershipId String
  branchId String
  organizationId String
  isActive Boolean @default(true)
  membership Membership @relation(fields: [membershipId, organizationId], references: [id, organizationId], onDelete: Cascade)
  branch Branch @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Cascade)
  @@id([membershipId, branchId])
  @@index([branchId, organizationId])
}
model StaffInvitation {
  id String @id @default(cuid())
  organizationId String
  email String
  role Role
  allBranches Boolean @default(false)
  tokenHash String @unique
  expiresAt DateTime
  acceptedAt DateTime?
  revokedAt DateTime?
  createdById String
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy User @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  branches InvitationBranch[]
  @@unique([id, organizationId])
  @@index([organizationId, createdAt])
}
model InvitationBranch {
  invitationId String
  branchId String
  organizationId String
  invitation StaffInvitation @relation(fields: [invitationId, organizationId], references: [id, organizationId], onDelete: Cascade)
  branch Branch @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Cascade)
  @@id([invitationId, branchId])
  @@index([branchId, organizationId])
}
model AuditLog {
  id String @id @default(cuid())
  actorProfileId String?
  actorProfile StaffProfile? @relation(fields: [actorProfileId], references: [id], onDelete: Restrict)
  actorUserId String?
  organizationId String
  branchId String?
  action String
  entityType String
  entityId String?
  metadata Json?
  createdAt DateTime @default(now())
  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch Branch? @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  @@index([organizationId, createdAt])
  @@index([branchId, createdAt])
}

model StaffProfile {
  acknowledgedRequests ServiceRequest[] @relation("RequestAcknowledgedProfile")
  completedRequests ServiceRequest[] @relation("RequestCompletedProfile")
  cancelledRequests ServiceRequest[] @relation("RequestCancelledProfile")
 createdSuppliers Supplier[] @relation("SupplierProfileCreator")
 createdCustomers Customer[] @relation("CustomerProfileCreator")
 cancelledPayments Payment[] @relation("PaymentCancelProfile")
 invoices Invoice[] @relation("InvoiceProfile")
  expenses Expense[] @relation("ExpenseProfile")
  expensePayments Payment[] @relation("ExpensePaymentProfile")
  id String @id @default(cuid())
  organizationId String
  membershipId String? @unique
  name String
  role Role @default(STAFF)
  isActive Boolean @default(true)
  allBranches Boolean @default(false)
  pinHash String?
  credentialVersion Int @default(1)
  failedAttempts Int @default(0)
  lockedUntil DateTime?
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  membership Membership? @relation(fields: [membershipId, organizationId], references: [id, organizationId], onDelete: Restrict)
  branchAccess StaffProfileBranch[]
  sessions StaffProfileSession[]
  auditLogs AuditLog[]
  currentAccountEntries CurrentAccountEntry[] @relation("CurrentEntryProfile")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([id, organizationId])
  @@unique([membershipId, organizationId])
  @@index([organizationId, isActive])
}
model StaffProfileBranch {
  profileId String
  organizationId String
  branchId String
  profile StaffProfile @relation(fields: [profileId, organizationId], references: [id, organizationId], onDelete: Cascade)
  branch Branch @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Cascade)
  @@id([profileId, branchId])
  @@index([branchId, organizationId])
}
model StaffProfileSession {
