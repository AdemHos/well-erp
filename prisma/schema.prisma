enum ServiceRequestType {
  WAITER_CALL
  BILL_REQUEST
}

enum ServiceRequestStatus {
  PENDING
  ACKNOWLEDGED
  COMPLETED
  CANCELLED
}

model ServiceRequest {
  id String @id @default(cuid())
  organizationId String
  branchId String
  tableId String
  tabId String?
  type ServiceRequestType
  status ServiceRequestStatus @default(PENDING)
  acknowledgedByUserId String?
  acknowledgedByProfileId String?
  completedByUserId String?
  completedByProfileId String?
  cancelledByUserId String?
  cancelledByProfileId String?
  acknowledgedAt DateTime?
  completedAt DateTime?
  cancelledAt DateTime?
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch Branch @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  table RestaurantTable @relation(fields: [tableId, branchId, organizationId], references: [id, branchId, organizationId], onDelete: Restrict)
  tab Tab? @relation(fields: [tabId, tableId, branchId, organizationId], references: [id, tableId, branchId, organizationId], onDelete: Restrict)
  acknowledgedByUser User? @relation("RequestAcknowledgedUser", fields: [acknowledgedByUserId], references: [id], onDelete: Restrict)
  completedByUser User? @relation("RequestCompletedUser", fields: [completedByUserId], references: [id], onDelete: Restrict)
  cancelledByUser User? @relation("RequestCancelledUser", fields: [cancelledByUserId], references: [id], onDelete: Restrict)
  acknowledgedByProfile StaffProfile? @relation("RequestAcknowledgedProfile", fields: [acknowledgedByProfileId, organizationId], references: [id, organizationId], onDelete: Restrict)
  completedByProfile StaffProfile? @relation("RequestCompletedProfile", fields: [completedByProfileId, organizationId], references: [id, organizationId], onDelete: Restrict)
  cancelledByProfile StaffProfile? @relation("RequestCancelledProfile", fields: [cancelledByProfileId, organizationId], references: [id, organizationId], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([organizationId, branchId, status, createdAt])
  @@index([organizationId, branchId, createdAt])
  @@index([tableId, type, createdAt])
}
